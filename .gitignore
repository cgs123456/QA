# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
test-results/
playwright-report/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Tauri
src-tauri/target/
src-tauri/gen/schemas

# Python sidecar
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# PRD §3.13 vendor binaries + dict: never commit, fetch via scripts/fetch-vendor.py
sidecar/vendor/*.dll
sidecar/vendor/*.so
sidecar/vendor/*.dylib
sidecar/vendor/dict/*
!sidecar/vendor/dict/.gitkeep

# Local model weights (~95MB): never commit, see sidecar/src/models/registry.py
sidecar/models/*
!sidecar/models/.gitkeep

# 1b regression recordings (task19): real human voice, local only, never commit.
# Manifest + guide stay in repo; wavs + annotations stay on the recording machine.
sidecar/tests/audio_samples/*.wav
sidecar/tests/audio_samples/*.json
!sidecar/tests/audio_samples/manifest.json

# 密钥与凭据：绝不入库。
# 此前 .gitignore 完全没有这一类覆盖 —— key 一旦被写进文件就有被提交的风险。
# 运行时凭据的正路是 keychain（Rust `keyring` crate）+ sidecar 内存（core/secrets.py），
# 不落盘；这里只是兜底，防止临时文件被误提交。
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json

# Local runtime
*.db
*.db-wal
*.db-shm
dist/
dist-sidecar/
build/
build-sidecar/
*.spec

# Agent 本地工作区：memory/ 是项目记忆（要提交，与 docs/ 同级看待），
# backup/ 是本地安全备份（不进仓库）。故只忽略 backup/，不整体忽略 .workbuddy-ai/。
.workbuddy-ai/backup/

# 一次性排查脚本：一律放仓库根、下划线前缀，用完即删（避免又攒成一批）。
/_*_probe.py
/_*_probe_*.py
